{
  "args": {
    "task": "go2",
    "num_envs": 2048,
    "skill_names": "walk",
    "seed": 0,
    "iterations": 100,
    "sim_device": "cuda:0",
    "rl_device": "cuda:0",
    "headless": true,
    "use_gpu_pipeline": true,
    "subscenes": 0,
    "num_threads": 10,
    "enable_noise": false,
    "enable_domain_rand": false,
    "command_resampling_time": 1000000000.0,
    "config_path": "configs/config_path.yaml",
    "log_dir": "logs_isaacgym",
    "save_model_dir": "checkpoints",
    "save_interval": 10,
    "target_pose_bank": "target_pose_bank/target_pose_bank.npy",
    "enable_sil": true,
    "use_skill_selector": false
  },
  "trainer_config": {
    "num_steps": 128,
    "ppo_epochs": 4,
    "mini_batch_size": 256,
    "clip_epsilon": 0.2,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "actor_lr": 0.0003,
    "critic_lr": 0.005,
    "max_grad_norm": 1.0,
    "value_loss_coef": 0.5,
    "entropy_coef": 0.002,
    "device": "cuda:0",
    "actor_hidden_dims": [
      128,
      128,
      128
    ],
    "critic_hidden_dims": [
      128,
      128,
      128
    ],
    "actor_activation": "elu",
    "critic_activation": "elu",
    "init_log_std": -0.5,
    "pose_weight": 0.5,
    "velocity_weight": 1.0,
    "command_weight": 0.0,
    "pose_sigma": 0.25,
    "velocity_sigma": 0.25,
    "yaw_weight": 0.75,
    "yaw_sigma": 0.25,
    "lin_vel_z_weight": -2.0,
    "ang_vel_xy_weight": -0.05,
    "flat_orientation_weight": -2.5,
    "height_weight": 0.0,
    "height_sigma": 0.05,
    "action_weight": 0.001,
    "smoothness_weight": 0.001,
    "stability_weight": 0.0,
    "joint_acceleration_weight": 0.0002,
    "roll_pitch_rate_weight": 0.0005,
    "yaw_rate_weight": 0.0001,
    "lateral_velocity_weight": 0.0005,
    "sigma_t": 0.5,
    "sigma_sil": 0.6,
    "omega_r": 1.0,
    "enable_sil": true,
    "use_skill_selector": false,
    "discriminator_config_path": "configs/training/discriminator.yaml",
    "discriminator_batch_size": 256,
    "discriminator_updates_per_iteration": 1,
    "sil_buffer_capacity_per_skill": 16,
    "trajectory_dtw_weight": 0.1,
    "trajectory_reference_length_ratio": 0.5,
    "trajectory_normalize_dtw": true,
    "trajectory_dtw_feature_slices": [
      [
        0,
        13
      ]
    ]
  },
  "config_path_dict": {
    "ppo_config_path": {
      "PPOTrainer_config_path": "configs/training/ppo.yaml"
    },
    "reward_weight_config_path": {
      "RewardWeight_config_path": "configs/rewards/weight.yaml"
    },
    "skill_one_hot_config_path": {
      "SkillOneHot_config_path": "configs/skills/skill_one_hot.yaml"
    },
    "discriminator_config_path": {
      "Discriminator_config_path": "configs/training/discriminator.yaml"
    }
  },
  "discriminator_config": {
    "model": {
      "hidden_layers": [
        512,
        256
      ],
      "activation": "elu"
    },
    "optimizer": {
      "name": "Adam",
      "lr": 0.0005,
      "weight_decay": 0.0
    },
    "loss": {
      "gradient_penalty_weight": 0.5,
      "expert_target": 1.0,
      "policy_target": -1.0
    },
    "trajectory_selector": {
      "min_task_return": 30.0,
      "max_dtw_distance": 0.62
    },
    "seed": {
      "seed": 0
    }
